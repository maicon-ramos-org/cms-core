---
/*
 * As fontes entram pelo componente `Fontes` (substituível): os arquivos são do site, e o
 * site sabe como servi-los. Cabeçalho e rodapé também são do site quando ele os troca
 * (`editorial({ componentes })`, PRD 17 RF3c).
 */
import Cabecalho from 'virtual:editorial/Cabecalho'
import Fontes from 'virtual:editorial/Fontes'
import Rodape from 'virtual:editorial/Rodape'

import { montaGrafo, noImagem, troncoDoSite, type No } from '@runzos/schema'

import { urlMidia, type MidiaDTO } from '../lib/cms'
import { PADRAO_CLARO, PADRAO_ESCURO, SOMBRAS, resolvePaleta, temaEscuroAtivo } from '../lib/tema'

/**
 * Layout base — TODO token de cor e fonte vem do TENANT (zero marca hardcoded, PRD 02
 * RF1). Os papéis são os de design-tokens.md v1.0.0, aprovado 27/08 com auditoria WCAG
 * AA: `--rz-action` só existe no botão que monetiza, e o texto dentro dele é escuro
 * porque branco sobre aquele verde reprova (2,44 contra o mínimo de 4,5).
 *
 * HTML 100% renderizado no servidor: dado de cupom NUNCA em Server Island (regra dura).
 */
interface Props {
  titulo: string
  descricao?: string
  noindex?: boolean
  /** canonical ABSOLUTO no host do tenant (staging nunca canoniza pra si mesmo) */
  canonical?: string
  /** gêmeo em markdown da página (agent-readable) */
  markdown?: string
  /**
   * Nós de JSON-LD que ESTA página acrescenta ao tronco (PRD 02 RF6). O tronco
   * (`Organization → WebSite → WebPage`) sai daqui de graça, em toda página: era ele que
   * faltava em 149 URLs quando o diff de paridade passou a comparar schema.
   */
  schema?: Array<No | null | undefined>
  /**
   * A mídia que representa a página (PRD 18 RF4). Recebe a MÍDIA, não uma URL: quem
   * escolhe o arquivo é este layout, e cada consumidor recebe o derivado feito pra ele —
   * o `og` (JPEG 1,91:1) pras redes sociais, a `capa` (16:9) pro schema.org, que é por
   * onde o Google Discover lê a imagem grande. Assim nenhuma página consegue mandar um
   * AVIF para o `og:image`, nem uma imagem fora da regra do Discover para o schema.
   */
  imagem?: MidiaDTO | null
  /** `og:type`: `article` no post; o resto do site é `website` */
  tipoOg?: 'website' | 'article'
}

const { titulo, descricao, noindex = false, canonical, markdown, schema = [], imagem, tipoOg = 'website' } = Astro.props

const tenant = Astro.locals.tenant
const t = tenant.tema ?? {}

/** Fallbacks só existem pra não quebrar tenant novo sem tema preenchido. */
/**
 * Ícone da aba: DADO do tenant, não arquivo em `public/`. Sem ele o navegador pede
 * `/favicon.ico` e leva 404 em toda página — era o único erro de console do site.
 */
const midiaFavicon = tenant.tema?.favicon
const favicon =
  midiaFavicon && typeof midiaFavicon === 'object' && midiaFavicon.url
    ? { url: urlMidia(midiaFavicon.url), tipo: midiaFavicon.url.endsWith('.svg') ? 'image/svg+xml' : 'image/png' }
    : null

/*
 * O CONJUNTO de ícones. Um arquivo só não serve: o Safari quer PNG de 180 pro atalho, o
 * Android quer 192/512 pelo manifest, e navegador antigo quer .ico. O SVG cobre os
 * modernos e escala sozinho — por isso vem primeiro na ordem.
 *
 * `tema.favicon` (um SVG solto) continua como reserva pra tenant que ainda não tem o
 * conjunto: o 3d, por exemplo.
 */
const url = (m: unknown): string | undefined =>
  m && typeof m === 'object' && (m as { url?: string }).url ? urlMidia((m as { url?: string }).url) : undefined
const ic = tenant.tema?.icones ?? {}
const icones = {
  svg: url(ic.svg) ?? (favicon?.tipo === 'image/svg+xml' ? favicon.url : undefined),
  ico: url(ic.ico),
  apple: url(ic.apple),
}
const temManifest = Boolean(url(ic.png192) && url(ic.png512))

/*
 * A imagem de compartilhamento (`og:image` + cartão grande do X), PRD 18 RF4.
 *
 * Sai SÓ do derivado `og` (1200×630, JPEG). Rede social não lê AVIF — e a original e a
 * `capa` são AVIF —, então nenhuma das duas serve nem como reserva: sem `sizes.og`, a
 * página não emite etiqueta nenhuma. O `mimeType` é conferido e não presumido: se o
 * derivado um dia mudar de formato na coleção, a etiqueta some em vez de apontar para
 * um arquivo que o Facebook, o LinkedIn e o X não renderizam.
 *
 * A URL tem que ser ABSOLUTA (o protocolo Open Graph exige). Em produção o
 * `CMS_PUBLIC_URL` é vazio de propósito e o `urlMidia` devolve caminho relativo, que a
 * mídia resolve pelo host do site; aqui o caminho é resolvido contra o host CANÔNICO do
 * tenant — o mesmo do `<link rel="canonical">`, então staging nunca vira a imagem
 * "oficial" de um post.
 */
const absoluta = (caminho: string) => new URL(caminho, `https://${tenant.canonical_host}/`).href
const derivadoOg = imagem?.sizes?.og
const caminhoOg = derivadoOg?.mimeType === 'image/jpeg' ? urlMidia(derivadoOg.url) : undefined
const imagemOg =
  derivadoOg && caminhoOg
    ? {
        url: absoluta(caminhoOg),
        largura: derivadoOg.width,
        altura: derivadoOg.height,
        tipo: derivadoOg.mimeType,
        alt: imagem?.alt,
      }
    : null

/*
 * A imagem principal no schema.org (`primaryImageOfPage` + o nó `#primaryimage`).
 *
 * O Google Discover só usa imagem GRANDE: pelo menos 1200px de largura, mais de 300 mil
 * pixels, proporção 16:9, liberada por `max-image-preview:large` e indicada pelo
 * `og:image` OU pelo schema.org (developers.google.com/search/docs/appearance/
 * google-discover, versão de 2026-03-09). O `og` acima tem 1200×630 — 1,91:1, a medida
 * das redes sociais, e NÃO 16:9. Quem cumpre a regra é a `capa` 1600×900, então ela é a
 * imagem do schema. AVIF é formato aceito pela busca do Google (google-images).
 *
 * Sem a `capa` (acervo antes do RF5), a original entra com as medidas dela: é o que a
 * página já declarava, agora com largura e altura e com URL absoluta — em produção o
 * `urlMidia` devolve caminho relativo, e schema.org pede URL absoluta.
 */
const derivadoCapa = imagem?.sizes?.capa
const caminhoPrincipal = urlMidia(derivadoCapa?.url ?? imagem?.url)
const imagemPrincipal = caminhoPrincipal
  ? {
      url: absoluta(caminhoPrincipal),
      largura: derivadoCapa?.url ? derivadoCapa.width : imagem?.width,
      altura: derivadoCapa?.url ? derivadoCapa.height : imagem?.height,
    }
  : null

/*
 * AS DUAS PALETAS (PRD 12). O escuro não é filtro sobre o claro: são dois conjuntos de
 * valores para os mesmos papéis, os dois auditados pela trava de contraste do Payload.
 *
 * As duas saem SEMPRE no mesmo HTML, e é o `@media (prefers-color-scheme: dark)` lá
 * embaixo que escolhe. Isso é o que mantém a página única por rota: o cache por tag do
 * ADR-0001 não se divide em variantes, o rastreador recebe o mesmo documento de sempre, e
 * não existe momento em que a tela pisca claro antes de virar escura — nada disso depende
 * de JavaScript.
 */
const claro = resolvePaleta(t, PADRAO_CLARO)
const escuroAtivo = temaEscuroAtivo(tenant)
/*
 * Tenant sem paleta escura curada recebe a CLARA de volta dentro do bloco escuro. Parece
 * redundante e é de propósito: o CSS sai sempre com a mesma forma (nada de bloco que
 * aparece e some, que é onde o Astro e o cache brigam), e um tenant sem escuro
 * simplesmente não muda de cor quando o sistema está no escuro. Melhor claro numa tela
 * escura do que um escuro deduzido no chute.
 */
const escuro = escuroAtivo ? resolvePaleta(tenant.tema_escuro, PADRAO_ESCURO) : claro
const sombras = escuroAtivo ? SOMBRAS.escuro : SOMBRAS.claro

/*
 * A SUPERFÍCIE INVERTIDA (rodapé). No tema claro ela é a inversão literal dos papéis: o
 * fundo vira a cor do texto e o texto vira a cor do fundo — a laje escura que separa o
 * rodapé do resto da página.
 *
 * No escuro essa mesma conta se vira contra si mesma: `--rz-ink` já é quase-branco, e o
 * rodapé viraria uma laje BRANCA no pé de uma página escura — o defeito mais visível que
 * um tema escuro mal feito produz. Então no escuro a laje deixa de ser inversão e passa a
 * ser elevação: a superfície de marca, que é um degrau acima do fundo.
 *
 * Fica resolvido AQUI, e não com um segundo `@media` dentro do rodapé, porque só este
 * arquivo sabe se o tenant TEM tema escuro. Um media query solto no componente pintaria o
 * rodapé de um tenant que optou por ficar só no claro.
 */
const inverso = escuroAtivo
  ? { fundo: escuro.cor_superficie_marca, ink: escuro.cor_texto }
  : { fundo: claro.cor_texto, ink: claro.cor_fundo }

const fontes = {
  fontTitulos: t.fonte_titulos ?? 'Lexend Deca',
  fontCorpo: t.fonte_corpo ?? 'Open Sans',
}

/**
 * Os nomes curtos que `define:vars` injeta. Prefixo `d` = escuro. Um mapa por paleta, com
 * as MESMAS chaves — se um papel existir só de um lado, o token fica indefinido e a
 * página perde a cor no tema em que ninguém olhou.
 */
const varsDoTema = (p: typeof claro, prefixo = '') => ({
  [`${prefixo}brand`]: p.cor_primaria,
  [`${prefixo}onBrand`]: p.cor_sobre_marca,
  [`${prefixo}bg`]: p.cor_fundo,
  [`${prefixo}action`]: p.cor_acao,
  [`${prefixo}onAction`]: p.cor_sobre_acao,
  [`${prefixo}deal`]: p.cor_desconto,
  [`${prefixo}verified`]: p.cor_verificado,
  [`${prefixo}ink`]: p.cor_texto,
  [`${prefixo}muted`]: p.cor_apoio,
  [`${prefixo}subtle`]: p.cor_sutil,
  [`${prefixo}surface`]: p.cor_superficie,
  [`${prefixo}surfaceBrand`]: p.cor_superficie_marca,
  [`${prefixo}surfaceVerified`]: p.cor_superficie_verificado,
  [`${prefixo}borda`]: p.cor_borda,
  [`${prefixo}bordaCodigo`]: p.cor_borda_codigo,
  [`${prefixo}surfaceExpirado`]: p.cor_superficie_expirado,
  [`${prefixo}aviso`]: p.cor_aviso,
})

const vars = {
  ...varsDoTema(claro),
  ...varsDoTema(escuro, 'd'),
  ...fontes,
  sombraSuave: SOMBRAS.claro.suave,
  sombraMedia: SOMBRAS.claro.media,
  sombraForte: SOMBRAS.claro.forte,
  dSombraSuave: sombras.suave,
  dSombraMedia: sombras.media,
  dSombraForte: sombras.forte,
  inversoFundo: claro.cor_texto,
  inversoInk: claro.cor_fundo,
  dInversoFundo: inverso.fundo,
  dInversoInk: inverso.ink,
  /* o que o navegador deve assumir quando o sistema pede escuro */
  esquemaEscuro: escuroAtivo ? 'dark' : 'light',
}
/*
 * O grafo, em UM bloco por página. Emitir o tronco aqui e não em cada rota é a correção
 * do defeito que o Gate D expôs: a regra vivia em oito templates e divergia nos oito — a
 * oferta lembrava de declarar Organization, o post não.
 *
 * Sem `canonical` não há `@id` estável, e `@id` instável é pior que schema ausente: o
 * consumidor passa a ver duas entidades onde havia uma. Nesse caso a página não emite.
 */
const grafo = canonical
  ? montaGrafo([
      ...troncoDoSite({
        tenant: {
          nome: tenant.nome,
          canonical_host: tenant.canonical_host,
          // o letreiro da marca, quando o tenant tem — vira `Organization.logo`
          logo:
            tenant.tema?.logo && typeof tenant.tema.logo === 'object'
              ? urlMidia((tenant.tema.logo as { url?: string }).url)
              : undefined,
        },
        url: canonical,
        titulo,
        descricao,
        imagem: imagemPrincipal?.url,
      }),
      // antes do `schema` da página: `montaGrafo` deduplica por `@id` e o primeiro vence
      imagemPrincipal
        ? noImagem(canonical, imagemPrincipal.url, { largura: imagemPrincipal.largura, altura: imagemPrincipal.altura })
        : null,
      ...schema,
    ])
  : null
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    {descricao && <meta name="description" content={descricao} />}
    {/*
      `follow`, não `nofollow`: as páginas que usam esta prop (/busca, /tag/{slug}) são
      ARQUIVOS — não devem rankear, mas os links delas levam a conteúdo que deve. É o que
      o WordPress emite hoje nas tags (`follow, noindex`), e trocar por `nofollow` cortaria
      a passagem do rastreador por 658 páginas de tag.

      Isto NÃO é o noindex de staging: aquele é por HOST e sai do proxy/robots.txt.
    */}
    {/*
      Fora do `noindex`, a permissão de prévia: `max-image-preview:large` é CONDIÇÃO do
      Google Discover (sem ela o card sai com miniatura pequena), e `max-snippet:-1` /
      `max-video-preview:-1` liberam trecho e vídeo sem limite — o padrão que o Rank Math
      emitia. Não é noindex: o smoke do deploy só reprova `robots` que contenha noindex.
    */}
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    {canonical && <link rel="canonical" href={canonical} />}
    {/*
      Compartilhamento (Open Graph). Título, descrição e URL são os MESMOS da página — o
      `<title>`, a `description` e o canonical —, pra que o cartão no WhatsApp, LinkedIn e
      X diga o que o buscador diz. O X lê `og:*` quando não há `twitter:*` próprio, então
      só o tipo de cartão é dele. A imagem sai só do derivado `og` (JPEG) — ver `imagemOg`.
    */}
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={tenant.nome} />
    <meta property="og:type" content={tipoOg} />
    <meta property="og:title" content={titulo} />
    {descricao && <meta property="og:description" content={descricao} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {imagemOg && (
      <>
        <meta property="og:image" content={imagemOg.url} />
        {imagemOg.largura && <meta property="og:image:width" content={String(imagemOg.largura)} />}
        {imagemOg.altura && <meta property="og:image:height" content={String(imagemOg.altura)} />}
        {imagemOg.tipo && <meta property="og:image:type" content={imagemOg.tipo} />}
        {imagemOg.alt && <meta property="og:image:alt" content={imagemOg.alt} />}
      </>
    )}
    <meta name="twitter:card" content={imagemOg ? 'summary_large_image' : 'summary'} />
    {imagemOg && <meta name="twitter:image" content={imagemOg.url} />}
    {/*
      O grafo de JSON-LD (PRD 02 RF6). `is:inline` porque o Astro não deve processar o
      conteúdo, e `set:html` porque `JSON.stringify` já produz o texto exato — interpolar
      como filho escaparia as aspas e o bloco viraria texto inválido pro consumidor.
    */}
    {grafo && <script is:inline type="application/ld+json" set:html={JSON.stringify(grafo)} />}
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    {/*
      Ordem importa: o navegador escolhe o ÚLTIMO que entende. `.ico` primeiro como piso,
      SVG depois porque é o melhor onde há suporte.
    */}
    {icones.ico && <link rel="icon" href={icones.ico} sizes="32x32" />}
    {icones.svg && <link rel="icon" type="image/svg+xml" href={icones.svg} />}
    {icones.apple && <link rel="apple-touch-icon" href={icones.apple} />}
    {temManifest && <link rel="manifest" href="/manifest.webmanifest" />}
    {/*
      `theme-color` pinta a barra do navegador no celular. Duas: a superfície clara no tema
      claro e o fundo escuro no escuro — uma cor só faria o texto do sistema sumir em um
      dos dois. Saem do TEMA do tenant, como o resto.
    */}
    <meta name="theme-color" content={claro.cor_superficie_marca} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={escuro.cor_superficie_marca} media="(prefers-color-scheme: dark)" />
    <meta name="msapplication-TileColor" content={claro.cor_primaria} />
    <Fontes />
    <style
      define:vars={vars}
    >
      :root {
        /*
         * `color-scheme` não é enfeite: é o que faz campo de formulário, barra de rolagem,
         * `<select>` nativo e a moldura que o navegador desenha acompanharem o tema. Sem
         * ele o site escurece e as caixas de texto continuam brancas.
         */
        color-scheme: light;
        --rz-brand: var(--brand);
        --rz-on-brand: var(--onBrand);
        --rz-bg: var(--bg);
        --rz-action: var(--action);
        --rz-on-action: var(--onAction);
        --rz-deal: var(--deal);
        --rz-verified: var(--verified);
        --rz-ink: var(--ink);
        --rz-muted: var(--muted);
        --rz-subtle: var(--subtle);
        --rz-surface: var(--surface);
        --rz-surface-brand: var(--surfaceBrand);
        --rz-surface-verificado: var(--surfaceVerified);
        --rz-borda-codigo: var(--bordaCodigo);
        --rz-surface-expirado: var(--surfaceExpirado);
        --rz-aviso: var(--aviso);
        --rz-borda: var(--borda);
        --rz-sombra-suave: var(--sombraSuave);
        --rz-sombra-media: var(--sombraMedia);
        --rz-sombra-forte: var(--sombraForte);
        /* laje que contrasta com a página — hoje só o rodapé */
        --rz-inverso: var(--inversoFundo);
        --rz-inverso-ink: var(--inversoInk);
        /*
         * Duas larguras, medidas no site atual: o CONTAINER (grade, cabeçalho, rodapé)
         * ocupa 1190px lá e ocupava 944 aqui — era o "parece bem menor". 74,5rem dá 1192,
         * e a folga até a borda fica igual à de lá (~44px em 1280).
         *
         * A MEDIDA de leitura tem 773 lá e tinha os mesmos 944 aqui: linha longa demais
         * para ler. Container largo com texto estreito é o arranjo certo — por isso são
         * dois tokens, e não um.
         */
        /*
         * FLUIDO até 95rem (1520px). Antes era fixo em 74,5rem: numa tela de 1440 ou 1680
         * sobrava margem vazia dos dois lados enquanto os cartões apertavam.
         *
         * `100vw - 5.5rem` mantém exatamente a largura de antes num viewport de 1280 (os
         * mesmos 1192px), então nada muda onde já estava bom — só cresce onde havia espaço
         * ocioso. O teto de 95rem é o do site de referência, medido: 1518px.
         */
        --rz-container: min(95rem, 100vw - 5.5rem);
        --rz-medida: 48rem;
        --rz-fonte-titulos: var(--fontTitulos), 'Segoe UI', Arial, sans-serif;
        --rz-fonte-corpo: var(--fontCorpo), 'Segoe UI', Arial, sans-serif;
        /*
         * Nome antigo mantido: componentes migrados ainda o referenciam. Aponta pro TOKEN
         * (--rz-brand) e não pro valor cru (--brand) — senão o componente que ficou no
         * nome velho continuaria roxo-claro no tema escuro, que foi exatamente o defeito
         * que o PRD 12 foi caçar.
         */
        --cor-primaria: var(--rz-brand);
        --cor-fundo: var(--rz-bg);
      }

      /*
       * O TEMA ESCURO. Só troca de valor: nenhuma regra de layout, nenhuma classe nova,
       * nenhum elemento a mais no HTML. Tudo que já lê `--rz-*` escurece junto, inclusive
       * componente que ninguém tocou — é por isso que o passo anterior deste PRD foi
       * matar os hex cravados, e não escrever CSS escuro componente a componente.
       */
      @media (prefers-color-scheme: dark) {
        :root {
          color-scheme: var(--esquemaEscuro);
          --rz-brand: var(--dbrand);
          --rz-on-brand: var(--donBrand);
          --rz-bg: var(--dbg);
          --rz-action: var(--daction);
          --rz-on-action: var(--donAction);
          --rz-deal: var(--ddeal);
          --rz-verified: var(--dverified);
          --rz-ink: var(--dink);
          --rz-muted: var(--dmuted);
          --rz-subtle: var(--dsubtle);
          --rz-surface: var(--dsurface);
          --rz-surface-brand: var(--dsurfaceBrand);
          --rz-surface-verificado: var(--dsurfaceVerified);
          --rz-borda-codigo: var(--dbordaCodigo);
          --rz-surface-expirado: var(--dsurfaceExpirado);
          --rz-aviso: var(--daviso);
          --rz-borda: var(--dborda);
          --rz-sombra-suave: var(--dSombraSuave);
          --rz-sombra-media: var(--dSombraMedia);
          --rz-sombra-forte: var(--dSombraForte);
          --rz-inverso: var(--dInversoFundo);
          --rz-inverso-ink: var(--dInversoInk);
        }
      }
      header.site {
        position: sticky; /* header fixo, como no site atual (design v1.1) */
        top: 0;
        z-index: 20;
        border-bottom: 1px solid var(--rz-borda);
        background: var(--rz-surface);
        padding: 0.75rem 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      header.site a.marca {
        font-family: var(--rz-fonte-titulos);
        font-size: 1.35rem;
        font-weight: 700;
        color: var(--rz-brand);
        text-decoration: none;
        letter-spacing: -0.01em;
      }
      main { max-width: var(--rz-container); margin: 0 auto; padding: 1.5rem; }
      footer.site {
        max-width: var(--rz-container);
        margin: 3rem auto 0;
        padding: 1.5rem;
        border-top: 1px solid var(--rz-borda);
        font-size: 0.85rem;
        color: var(--rz-muted);
      }
      @media (max-width: 480px) {
        body { font-size: 17px; }
        h1 { font-size: 1.6rem; }
        main { padding: 1rem; }
      }
    </style>
    <style is:global>
      /*
       * Some da vista, fica no documento — H1 da home, rótulo do campo de busca. Precisa
       * ser GLOBAL: style escopado do layout não alcança o markup das páginas, e foi
       * exatamente assim que o H1 continuou aparecendo na primeira tentativa.
       *
       * Não é `display:none` nem `visibility:hidden`: os dois tiram do leitor de tela
       * também, que é o oposto do que se quer.
       */
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      /*
       * A CAMADA NÃO-CROMÁTICA DO DESIGN SYSTEM (PRD 13).
       *
       * Cor já era sistema — 17 papéis, dado do tenant, duas paletas auditadas. Forma,
       * espaço, elevação e movimento não eram: cada componente escolhia o seu número, e
       * o site acumulou TREZE raios diferentes dizendo a mesma coisa.
       *
       * Mora no `is:global`, e não no bloco escopado acima, por um motivo mecânico: o
       * seletor precisa alcançar `[data-tema]`, que é elemento de PÁGINA (o palco do
       * /design-system). Regra escopada do layout não sai do layout.
       *
       * `:where()` zera a especificidade — token é padrão, não imposição: qualquer
       * componente sobrescreve sem precisar de `!important`.
       */
      :where(:root, [data-tema]) {
        /* FORMA — um raio por papel. Os 13 valores de hoje colapsam nestes quatro. */
        --rz-raio-selo: 6px; /* etiqueta, badge, campo pequeno */
        --rz-raio-botao: 10px; /* botão, campo de formulário */
        --rz-raio-cartao: 12px; /* cartão, painel, caixa */
        --rz-raio-pilula: 999px; /* chip, raspadinha, selo de desconto */

        /* ESPAÇO — escala de 4px. Nome curto: aparece em toda regra de padding e gap. */
        --rz-espaco-1: 0.25rem;
        --rz-espaco-2: 0.5rem;
        --rz-espaco-3: 0.75rem;
        --rz-espaco-4: 1rem;
        --rz-espaco-5: 1.5rem;
        --rz-espaco-6: 2rem;
        --rz-espaco-7: 3rem;

        /*
         * ELEVAÇÃO — a sombra INTEIRA, não só o alfa dela. `--rz-sombra-*` já existia e é
         * só a cor; cada componente remontava o offset por conta, e eram oito
         * `box-shadow` distintos dizendo "levantei um pouco". Aqui são quatro degraus — e
         * o degrau no escuro vem de graça, porque `--rz-sombra-*` já troca de alfa por
         * tema (a mesma sombra que separa cartão branco de fundo branco é invisível entre
         * dois quase-pretos).
         */
        --rz-elevacao-1: 0 1px 2px var(--rz-sombra-suave); /* botão em repouso */
        --rz-elevacao-2: 0 2px 10px var(--rz-sombra-suave); /* cartão levantado no hover */
        --rz-elevacao-3: 0 12px 30px var(--rz-sombra-media); /* menu, popover */
        --rz-elevacao-4: 0 24px 60px var(--rz-sombra-forte); /* diálogo */

        /* MOVIMENTO — duas durações. Cor e borda respondem rápido; forma e sombra, não. */
        --rz-transicao-rapida: 120ms ease;
        --rz-transicao: 200ms ease;

        /*
         * ESTADOS. A regra é uma só: hover MISTURA O PAPEL COM `--rz-ink`.
         *
         * É o que conserta o defeito que o tema escuro expôs. O hover do CTA era
         * `filter: brightness(0.94)`, que ESCURECE. No claro isso lê como "afundou,
         * respondeu ao mouse"; no escuro, escurecer um verde já escuro sobre fundo
         * quase preto lê como o botão apagando — e é justamente o único elemento da
         * página que monetiza o site.
         *
         * `--rz-ink` é quase-preto no claro e quase-branco no escuro. Misturar com ele
         * escurece de dia e clareia de noite: uma expressão, dois temas, nenhum `@media`
         * e nenhum hex — o que também a mantém dentro da trava do `confere-cor-cravada`.
         *
         * Por estarem declarados TAMBÉM em `[data-tema]`, estes recalculam dentro de
         * qualquer escopo que redeclare os papéis. É assim que o palco escuro do
         * /design-system mostra o hover escuro sem duplicar uma linha de fórmula.
         */
        --rz-action-hover: color-mix(in srgb, var(--rz-action) 88%, var(--rz-ink));
        --rz-action-ativo: color-mix(in srgb, var(--rz-action) 78%, var(--rz-ink));
        --rz-brand-hover: color-mix(in srgb, var(--rz-brand) 88%, var(--rz-ink));
        --rz-surface-hover: color-mix(in srgb, var(--rz-brand) 7%, var(--rz-surface));
        --rz-anel-foco: 3px;
        --rz-anel-foco-folga: 2px;
      }

      /*
       * Menos movimento, no site INTEIRO. Antes só dois componentes respeitavam a
       * preferência, cada um com o seu `@media` — e toda transição nova nascia
       * desobediente. `0.01ms` em vez de `none` de propósito: o evento `transitionend`
       * continua disparando, então script que espera por ele não trava.
       */
      @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
          transition-duration: 0.01ms !important;
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          scroll-behavior: auto !important;
        }
      }

      /* Estas regras miram elementos das PÁGINAS (h1 do post, links do corpo), que o
         style escopado deste layout não alcança — daí o is:global. As variáveis vêm por
         herança do bloco acima, então continuam sendo dado do tenant. */
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: var(--rz-fonte-corpo);
        font-size: 18px;
        background: var(--rz-bg);
        color: var(--rz-ink);
        line-height: 1.6;
      }
      h1, h2, h3, h4 { font-family: var(--rz-fonte-titulos); line-height: 1.25; }
      h1 { font-weight: 700; font-size: 2rem; letter-spacing: -0.015em; }
      h2 { font-weight: 600; font-size: 1.4rem; margin-top: 2rem; }
      h3 { font-weight: 600; font-size: 1.15rem; }
      a { color: var(--rz-brand); }
      /* regra 2 do design: foco de teclado visível em TUDO que interage */
      :where(a, button, summary, input, select, textarea):focus-visible {
        outline: var(--rz-anel-foco) solid var(--rz-brand);
        outline-offset: var(--rz-anel-foco-folga);
        border-radius: var(--rz-raio-selo);
      }
      /* regra 1: alvo de toque >= 44px em item de lista clicável */
      main li > a { display: inline-block; padding: 0.25rem 0; min-height: 32px; }
      @media (max-width: 480px) {
        body { font-size: 17px; }
        h1 { font-size: 1.6rem; }
      }
    </style>
  </head>
  <body>
    <Cabecalho />
    <main>
      <slot />
    </main>
    <Rodape />
  </body>
</html>
