{
  "name": "@maicon-ramos-org/editorial",
  "version": "0.2.0-next.2",
  "description": "Tema editorial como integração Astro: rotas injetadas e componentes substituíveis (PRD 17 RF3)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lib/*": "./src/lib/*.ts",
