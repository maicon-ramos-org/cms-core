{
  "name": "@maicon-ramos-org/editorial",
  "version": "0.1.0",
  "description": "Tema editorial como integração Astro: rotas injetadas e componentes substituíveis (PRD 17 RF3)",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./middleware": "./src/middleware.ts",
    "./componentes/*": "./src/componentes/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mcp-b/webmcp-polyfill": "^5.1.0",
    "@maicon-ramos-org/schema": "workspace:*",
    "@maicon-ramos-org/webmcp": "workspace:*"
  },
  "peerDependencies": {
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "astro": "^7.2.4",
    "typescript": "5.7.3",
    "vitest": "4.0.18"
  }
}
