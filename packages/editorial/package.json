    "directory": "packages/editorial"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mcp-b/webmcp-polyfill": "^5.1.0",
    "@maicon-ramos-org/schema": "workspace:*",
    "@maicon-ramos-org/webmcp": "workspace:*"
  },
  "peerDependencies": {
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "astro": "^7.2.4",
    "typescript": "5.7.3",
    "vitest": "4.0.18"
  }
}
