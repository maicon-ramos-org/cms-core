---
import OpcoesCompraProduto from '../../../src/web/componentes/OpcoesCompraProduto.astro'
import { fichaDeProduto } from '../../../src/conteudo'
import { produtoFixture, variantesFixture } from './dados'
const cenario = Astro.params.cenario
const oferta = { id: 1, tenant: 7, variantId: 4,
  seller: { id: 2, name: 'Loja de equipamentos' }, price: null,
  affiliateUrl: 'https://loja.example.test/produto?sku=preto&ref=afiliado',
  observedAt: '2026-09-26T10:00:00Z' }
const listings = cenario === 'multilojas' ? [oferta, { ...oferta, id: 2, variantId: 6,
  seller: { id: 3, name: 'Outra loja' }, affiliateUrl: '/r/o2?ref=produto' }] : [oferta]
const ficha = fichaDeProduto(produtoFixture, { tenantId: 7,
  variants: variantesFixture.map(v => ({ id: v.id, tenant: v.tenant, name: v.nome })), listings })!
if (['preco', 'sem-data', 'data-futura'].includes(cenario ?? '')) {
  const item = ficha.monetization.listings[0]!
  item.price = { amount: '199.90', currency: 'BRL' }
  item.availability = 'in-stock'
  item.coupon = { code: 'CUPOM-LITERAL-NAO-PUBLICO', url: null, expiresAt: null }
  if (cenario === 'sem-data') item.observedAt = null
  if (cenario === 'data-futura') item.observedAt = '2099-01-01T00:00:00Z'
}
if (cenario === 'link-invalido') ficha.monetization.listings = [
  { ...ficha.monetization.listings[0]!, affiliateUrl: 'javascript:alert(1)' },
  { ...ficha.monetization.listings[0]!, affiliateUrl: '//externo.example.test' },
]
---
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8" /><title>Compra de teste</title></head>
<body><OpcoesCompraProduto monetizacao={ficha.monetization} /></body></html>
