---
import type { getCatalogoProduto } from '../lib/catalogo'
import { urlMidia } from '../lib/cms'
import { imagemRenderizavel } from '../lib/imagem-oficial'
interface Props { catalogo: NonNullable<Awaited<ReturnType<typeof getCatalogoProduto>>> }
const { produto, variantes, ofertas } = Astro.props.catalogo
const imagemProduto = imagemRenderizavel(produto, produto.nome, urlMidia)
---
<main class="ficha">
  {imagemProduto && <img class="produto-imagem" src={imagemProduto.src} alt={imagemProduto.alt}
    width={imagemProduto.width} height={imagemProduto.height} loading="lazy" decoding="async" />}
  <h1>{produto.nome}</h1>
  <p>{produto.marca} · {produto.modelo}</p>
  {produto.descricao && <p>{produto.descricao}</p>}
  <p>Como associado da Amazon, eu recebo por compras qualificadas.</p>
  {variantes.map(v => {
    const imagemVariante = imagemRenderizavel(v, `${produto.nome} — ${v.nome}`, urlMidia)
    return <section>
      {imagemVariante && <img class="variante-imagem" src={imagemVariante.src} alt={imagemVariante.alt}
        width={imagemVariante.width} height={imagemVariante.height} loading="lazy" decoding="async" />}
      <h2>{v.nome}</h2>
      {ofertas.filter(o => String(o.variante) === String(v.id)).map(o =>
        <p><a href={`/r/f${o.id}`} rel="sponsored noopener">Ver preço na Amazon</a></p>
      )}
    </section>
  })}
  {ofertas.length === 0 && <p>Nenhuma oferta revisada disponível para consulta.</p>}
</main>
<style>
  .ficha { max-width: 70rem; margin: 0 auto; padding: 2rem 1rem; }
  .produto-imagem, .variante-imagem { display: block; width: 100%; max-width: 30rem; height: auto; object-fit: contain; }
  .variante-imagem { max-width: 20rem; }
  section { margin-block: 2rem; }
  a { display: inline-block; padding: .8rem 1rem; background: var(--rz-action); color: var(--rz-on-action); border-radius: .5rem; }
</style>
