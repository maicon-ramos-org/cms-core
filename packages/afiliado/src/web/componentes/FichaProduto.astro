---
import { destinoAmazon, type getCatalogoProduto } from '../lib/catalogo'
import { produtoEditorialDTO, produtoMarkdownHtml } from '../../conteudo'
interface Props { catalogo: NonNullable<Awaited<ReturnType<typeof getCatalogoProduto>>> }
const { produto, variantes, ofertas } = Astro.props.catalogo
const editorial = produtoEditorialDTO(produto)
const corpoHtml = editorial.content.descriptionMarkdown ? produtoMarkdownHtml(editorial.content.descriptionMarkdown) : null
---
<main class="ficha">
  <h1>{produto.nome}</h1>
  <p>{produto.marca} · {produto.modelo}</p>
  {editorial.content.summary && <p class="resumo">{editorial.content.summary}</p>}
  {corpoHtml && <div class="corpo" set:html={corpoHtml} />}
  {editorial.content.highlights.length > 0 && <section aria-label="Destaques">
    <h2>Destaques</h2>
    <ul>{editorial.content.highlights.map(destaque => <li>{destaque}</li>)}</ul>
  </section>}
  {editorial.content.faq.length > 0 && <section aria-label="Perguntas frequentes">
    <h2>Perguntas frequentes</h2>
    {editorial.content.faq.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}
  </section>}
  <p>Como associado da Amazon, eu recebo por compras qualificadas.</p>
  {variantes.map(v => <section>
    <h2>{v.nome}</h2>
    {ofertas.filter(o => String(o.variante) === String(v.id)).map(o => {
      const href = destinoAmazon(o)
      return href ? <p><a href={href} rel="sponsored noopener noreferrer" target="_blank">Ver preço na Amazon</a></p> : null
    })}
  </section>)}
  {ofertas.length === 0 && <p>Nenhuma oferta revisada disponível para consulta.</p>}
</main>
<style>
  .ficha { max-width: 70rem; margin: 0 auto; padding: 2rem 1rem; }
  section { margin-block: 2rem; }
  .resumo, .corpo { max-width: 72ch; line-height: 1.6; }
  details { margin-block: .75rem; }
  a { display: inline-block; padding: .8rem 1rem; background: var(--rz-action); color: var(--rz-on-action); border-radius: .5rem; }
</style>
