---
/**
 * Componente ÚNICO de CTA de monetização (contrato redirect-afiliado.md):
 * - sempre /r/{id}?ref=... — link de afiliado cru NUNCA no HTML
 * - sempre rel="sponsored nofollow"
 */
interface Props {
  docId: string | number
  rotulo?: string
  ref?: string
}

const { docId, rotulo = 'Usar cupom na loja', ref = 'pagina' } = Astro.props
---

<a class="cta" href={`/r/${docId}?ref=${ref}`} rel="sponsored nofollow">
  {rotulo}
</a>

<style>
  .cta {
    display: inline-block;
    background: var(--cor-primaria);
    color: #fff;
    padding: 0.55rem 1.1rem;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
  }
  .cta:hover { filter: brightness(0.92); }
</style>
