---
/**
 * Componente ÚNICO de CTA de monetização (contrato redirect-afiliado.md):
 * - sempre /r/{id}?ref=... — link de afiliado cru NUNCA no HTML
 * - sempre rel="sponsored nofollow"
 */
interface Props {
  tipo: 'cupom' | 'produto' | 'oferta'
  docId: string | number
  rotulo?: string
  ref?: string
}

const PREFIXO = { cupom: 'c', produto: 'p', oferta: 'o' } as const
const { tipo, docId, rotulo = 'Usar cupom na loja', ref = 'pagina' } = Astro.props
---

<a class="cta" href={`/r/${PREFIXO[tipo]}${docId}?ref=${ref}`} rel="sponsored nofollow">
  {rotulo}
</a>

<style>
  /* --rz-action existe SÓ aqui: é a regra 3 do design system (verde = monetização).
     Texto escuro dentro do verde porque branco reprova no WCAG (2,44); o par
     #04240b sobre #07C03B dá 6,82. Altura mínima 44px = alvo de toque. */
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    background: var(--rz-action);
    color: var(--rz-on-action);
    padding: 0.6rem 1.4rem;
    border-radius: 8px;
    text-decoration: none;
    font-family: var(--rz-fonte-titulos);
    font-weight: 600;
    font-size: 1rem;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
  }
  .cta:hover { filter: brightness(0.94); }
  .cta:active { transform: translateY(1px); }
</style>
