---
/**
 * Card de cupom — dado 100% do banco, renderizado no servidor.
 * Selo de verificação: verificado há Xh + método (+ taxa quando houver) — PRD 02 RF5.
 */
import type { CupomDTO } from '../lib/cms'
import CtaAfiliado from './CtaAfiliado.astro'

interface Props {
  cupom: CupomDTO
}

const { cupom } = Astro.props

const descontoLabel = (() => {
  switch (cupom.desconto_tipo) {
    case 'percentual':
      return `${cupom.desconto_valor ?? '?'}% OFF`
    case 'valor':
      return `R$ ${cupom.desconto_valor ?? '?'} OFF`
    case 'frete':
      return 'FRETE GRÁTIS'
    default:
      return 'OFERTA'
  }
})()

const seloVerificacao = (() => {
  if (!cupom.verificado_em) return null
  const horas = Math.max(0, Math.round((Date.now() - new Date(cupom.verificado_em).getTime()) / 3_600_000))
  const quando = horas < 1 ? 'agora há pouco' : horas < 48 ? `há ${horas}h` : `há ${Math.round(horas / 24)} dias`
  const metodo =
    cupom.metodo === 'api' ? 'via API da loja' : cupom.metodo === 'corroboracao' ? 'por corroboração' : 'manualmente'
  return `Verificado ${quando} ${metodo}`
})()
---

<article class="cupom">
  <div class="desconto">{descontoLabel}</div>
  <div class="corpo">
    <code class="codigo">{cupom.codigo}</code>
    {cupom.condicoes && <p class="condicoes">{cupom.condicoes}</p>}
    {
      seloVerificacao && (
        <p class="selo">
          ✓ {seloVerificacao}
          {typeof cupom.taxa_sucesso === 'number' && ` · funcionou pra ${cupom.taxa_sucesso}% de quem usou`}
        </p>
      )
    }
  </div>
  <CtaAfiliado tipo="cupom" docId={cupom.id} />
</article>

<style>
  /* Papéis do design system: desconto em --rz-deal (é o número que vende), selo em
     --rz-verified. O verde de ação NÃO aparece aqui — só no botão (CtaAfiliado). */
  .cupom {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    background: var(--rz-surface);
    border: 1px solid var(--rz-borda);
    border-radius: 12px;
    padding: 1rem 1.15rem;
    margin-bottom: 0.85rem;
  }
  .desconto {
    min-width: 108px;
    font-family: var(--rz-fonte-titulos);
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--rz-deal);
  }
  .corpo { flex: 1; min-width: 200px; }
  .codigo {
    display: inline-flex;
    align-items: center;
    min-height: 44px; /* alvo de toque: o código é copiável */
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    background: var(--rz-surface-brand);
    border: 1px dashed var(--rz-brand);
    border-radius: 8px;
    padding: 0.2rem 0.75rem;
    color: var(--rz-ink);
  }
  .condicoes { margin: 0.4rem 0 0; font-size: 0.9rem; color: var(--rz-muted); }
  .selo {
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--rz-verified);
  }
</style>
