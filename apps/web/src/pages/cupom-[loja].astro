---
/**
 * PRD 02 RF5 — página /cupom-{loja}:
 * - title "{n} Cupons {Loja} Testados em {Mês} {Ano}" com N e mês REAIS (pattern do tenant)
 * - selo por cupom + bloco de última verificação + FAQ visível + FAQPage JSON-LD
 * - SSR + cache tags [tenant:{slug}, loja:{slug}]
 */
import CupomCard from '../components/CupomCard.astro'
import Base from '../layouts/Base.astro'
import { getCuponsDaLoja, getCuponsExpiradosDaLoja, getLojaBySlug } from '../lib/cms'

const tenant = Astro.locals.tenant
const slugLoja = Astro.params.loja ?? ''

const loja = await getLojaBySlug(tenant.id, slugLoja)
if (!loja) {
  return new Response('Loja não encontrada.', { status: 404 })
}

if (Astro.cache.enabled) {
  Astro.cache.set({ maxAge: 300, swr: 60, tags: [`tenant:${tenant.slug}`, `loja:${loja.slug}`] })
}

const [cupons, expirados] = await Promise.all([getCuponsDaLoja(loja.id), getCuponsExpiradosDaLoja(loja.id)])

const agora = new Date()
const mes = new Intl.DateTimeFormat('pt-BR', { month: 'long' }).format(agora)
const mesCapitalizado = mes.charAt(0).toUpperCase() + mes.slice(1)
const pattern = tenant.seo?.title_pattern_loja ?? '{n} Cupons {loja} Testados em {mes} {ano}'
let titulo = pattern
  .replace('{n}', String(cupons.length))
  .replace('{loja}', loja.nome)
  .replace('{mes}', mesCapitalizado)
  .replace('{ano}', String(agora.getFullYear()))
// singular sem quebrar o pattern configurável do tenant
if (cupons.length === 1) titulo = titulo.replace(/\b1 Cupons\b/, '1 Cupom').replace(/\bTestados\b/, 'Testado')

const ultimaVerificacao = cupons
  .map((c) => (c.verificado_em ? new Date(c.verificado_em) : null))
  .filter((d): d is Date => d !== null)
  .sort((a, b) => b.getTime() - a.getTime())[0]

const faq = loja.faq ?? []
const jsonLd =
  faq.length > 0
    ? JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faq.map((item) => ({
          '@type': 'Question',
          name: item.pergunta,
          acceptedAnswer: { '@type': 'Answer', text: item.resposta },
        })),
      })
    : null
---

<Base titulo={titulo} descricao={`Cupons ${loja.nome} com selo de verificação — atualizado em ${mesCapitalizado} de ${agora.getFullYear()}.`}>
  <h1>{titulo}</h1>

  {
    ultimaVerificacao && (
      <p class="ultima-verificacao">
        Última verificação deste catálogo:{' '}
        {new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long', timeStyle: 'short' }).format(ultimaVerificacao)}
      </p>
    )
  }

  {cupons.length === 0 && <p>Nenhum cupom ativo pra {loja.nome} agora — volte em breve.</p>}
  {cupons.map((cupom) => <CupomCard cupom={cupom} />)}

  {/* Expirados ficam, recolhidos: transparência é o argumento do produto (design v1.1) */}
  {
    expirados.length > 0 && (
      <details class="expirados">
        <summary>
          {expirados.length} {expirados.length === 1 ? 'cupom expirado' : 'cupons expirados'} — mantidos por transparência
        </summary>
        <p class="aviso-expirado">
          Estes códigos não funcionavam na última verificação. Ficam aqui para você conferir
          o histórico — nunca apagamos o que já testamos.
        </p>
        <ul class="lista-expirada">
          {expirados.map((c) => (
            <li>
              <span class="codigo-expirado">{c.codigo}</span>
              {c.verificado_em && (
                <span class="quando">
                  testado em {new Intl.DateTimeFormat('pt-BR', { dateStyle: 'short' }).format(new Date(c.verificado_em))}
                </span>
              )}
            </li>
          ))}
        </ul>
      </details>
    )
  }

  {
    faq.length > 0 && (
      <section>
        <h2>Perguntas frequentes</h2>
        {faq.map((item) => (
          <details>
            <summary>{item.pergunta}</summary>
            <p>{item.resposta}</p>
          </details>
        ))}
      </section>
    )
  }

  {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
</Base>

<style>
  .ultima-verificacao { font-size: 0.9rem; color: var(--rz-muted); }
  /* Sem `opacity` no container: derruba o contraste do texto abaixo do mínimo (v1.1). */
  .expirados {
    background: var(--rz-surface-expirado);
    border: 1px solid var(--rz-borda);
    border-radius: 10px;
    padding: 0.75rem 1rem;
    margin: 1.5rem 0;
  }
  .expirados summary { font-weight: 600; min-height: 44px; display: flex; align-items: center; }
  .aviso-expirado { font-size: 0.85rem; color: var(--rz-aviso); margin: 0.5rem 0; }
  .lista-expirada { list-style: none; padding: 0; margin: 0; }
  .lista-expirada li { display: flex; gap: 0.75rem; align-items: baseline; padding: 0.3rem 0; }
  .codigo-expirado {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-weight: 700;
    text-decoration: line-through;
    color: var(--rz-ink);
  }
  .quando { font-size: 0.8rem; color: var(--rz-muted); }
  details { margin-bottom: 0.5rem; }
  summary { cursor: pointer; font-weight: 600; }
</style>
