---
/**
 * PRD 02/03 — página /ofertas/{slug} (paridade de URL com o WordPress atual).
 *
 * Decisão de render: SSR + cache por tag. A oferta muda com o catálogo (preço, cupom,
 * estado), então NÃO é prerender — e o dado de cupom nunca vai pra Server Island: sai
 * inteiro no HTML inicial, porque crawler de IA não executa JS.
 */
import CardOferta from '../../components/CardOferta.astro'
import Compartilhar from '../../components/Compartilhar.astro'
import CtaAfiliado from '../../components/CtaAfiliado.astro'
import CupomCard from '../../components/CupomCard.astro'
import Base from '../../layouts/Base.astro'
import { compor } from '@runzos/desconto'

import { caminhoDaOferta, caminhoCanonico, getOfertaBySlug, getOfertasDaLoja, urlMidia, type CupomDTO, type LojaDTO } from '../../lib/cms'
import { lexicalParaHtml, lexicalParaTexto } from '../../lib/lexical'

const tenant = Astro.locals.tenant
const slug = Astro.params.slug ?? ''

const oferta = await getOfertaBySlug(tenant.id, slug)
if (!oferta) {
  return new Response('Oferta não encontrada.', { status: 404 })
}

const loja: LojaDTO | null = oferta.loja && typeof oferta.loja === 'object' ? oferta.loja : null
const cupom: CupomDTO | null = oferta.cupom && typeof oferta.cupom === 'object' ? oferta.cupom : null

/**
 * Cupom migrado do WP entra em `revisao` (sem selo de verificação) e o /r/{id} se recusa
 * a monetizá-lo — corretamente. Então a página só mostra o card do cupom quando ele está
 * num estado visível; senão o CTA é o da oferta, que funciona. Mesma régua do
 * /cupom-{loja}: sem selo, sem cupom na tela.
 */
const CUPOM_VISIVEL = new Set(['publicado', 'expirando'])
const cupomVisivel = cupom && CUPOM_VISIVEL.has(cupom.estado) ? cupom : null

if (Astro.cache.enabled) {
  Astro.cache.set({
    maxAge: 300,
    swr: 60,
    tags: [
      `tenant:${tenant.slug}`,
      `ofertas:${oferta.id}`,
      ...(loja ? [`loja:${loja.slug}`] : []),
      ...(cupom ? [`cupons:${cupom.id}`] : []),
    ],
  })
}

const relacionadas = loja ? await getOfertasDaLoja(loja.id, oferta.id) : []

/**
 * Desconto empilhado (spec §1). `compor()` devolve null quando falta dado ou quando o
 * modo de incidência é desconhecido — e aí a página mostra os dois descontos SEPARADOS,
 * nunca um total inventado. (O "77%" do mockup era impossível: 70+10 dá 73 ou 80.)
 */
const composto = compor(oferta.desconto_loja, cupomVisivel)
const decomposicao = composto
  ? composto.parcelas.map((p) => `${p.valor_pct}% ${p.rotulo}`).join(' + ')
  : null
const descontoLojaIsolado =
  !composto && oferta.desconto_loja?.tipo === 'percentual' && typeof oferta.desconto_loja.valor === 'number'
    ? oferta.desconto_loja
    : null

/** Link de afiliado desta oferta/cupom que apareça no corpo migrado vira /r/{id}. */
const destinos = new Map<string, string>()
if (oferta.url_afiliado_fonte) destinos.set(oferta.url_afiliado_fonte, `/r/o${oferta.id}?ref=corpo`)
if (cupom?.url_afiliado_fonte) destinos.set(cupom.url_afiliado_fonte, `/r/c${cupom.id}?ref=corpo`)

const corpoHtml = lexicalParaHtml(oferta.corpo, {
  reescreveAfiliado: (url) => destinos.get(url) ?? destinos.get(url.replace(/\/$/, '')) ?? null,
  resolveMidia: urlMidia,
  hostDoTenant: tenant.canonical_host,
})
/**
 * Na virada, title e description de página de acervo são os que o WP publica hoje —
 * decisão de atribuição: o Google já vai recrawlear tudo por causa da troca de origem,
 * e somar mudança de título à mesma janela impede saber qual das duas mexeu no tráfego.
 * Melhorar título é deploy separado, depois do gate.
 */
const resumo = lexicalParaTexto(oferta.corpo, 155)
const tituloPagina = oferta.meta?.title || oferta.titulo
const descricao = oferta.meta?.description || resumo || `${oferta.titulo} — oferta verificada no ${tenant.nome}.`

// canonical absoluto no host do tenant (nunca o host da requisição: staging não canoniza pra si)
const canonical = `https://${tenant.canonical_host}${caminhoDaOferta(oferta)}`

const precoValido = typeof oferta.preco?.valor === 'number' && oferta.preco.valor > 0
const moeda = oferta.preco?.moeda ?? 'BRL'
const precoFormatado = precoValido
  ? new Intl.NumberFormat('pt-BR', { style: 'currency', currency: moeda }).format(oferta.preco!.valor!)
  : null
const precoEm = oferta.preco?.preco_em ? new Date(oferta.preco.preco_em) : null

/*
 * Imagem em destaque. `srcset` com os dois tamanhos: o derivado de 640 atende a coluna
 * no desktop e a tela do celular; o original de 1280 cobre densidade 2x. Sem isso a
 * página baixaria 1280px pra exibir em 620.
 */
const img = oferta.imagem && typeof oferta.imagem === 'object' ? oferta.imagem : null
const heroSrc = urlMidia(img?.sizes?.cartao?.url ?? img?.url)
const heroSrcset = [
  img?.sizes?.cartao?.url ? `${urlMidia(img.sizes.cartao.url)} 640w` : null,
  img?.url ? `${urlMidia(img.url)} ${img.width ?? 1280}w` : null,
]
  .filter(Boolean)
  .join(', ')

const logoLoja = loja?.logo && typeof loja.logo === 'object' ? loja.logo : null
const beneficios = (oferta.beneficios ?? []).map((b) => b.texto).filter((t): t is string => Boolean(t))

const rotuloTipo: Record<string, string> = {
  cupom: 'Cupom de desconto',
  credito: 'Crédito grátis',
  lifetime: 'Oferta lifetime',
  desconto_api: 'Desconto em API',
}

/**
 * JSON-LD em GRAFO com @id (regra do projeto): Offer com preço/moeda REAIS do banco +
 * BreadcrumbList. Sem preço no banco não se inventa `price` — o nó Offer sai sem ele.
 */
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Offer',
      '@id': `${canonical}#offer`,
      name: oferta.titulo,
      url: canonical,
      ...(precoValido ? { price: oferta.preco!.valor, priceCurrency: moeda } : {}),
      ...(precoEm ? { availabilityStarts: precoEm.toISOString() } : {}),
      // seller SEM url: `lojas.url_site` foi derivado do link de afiliado na migração e
      // costuma ser o domínio da REDE (m.do.co, anrdoezrs.net). Publicar isso seria link
      // de afiliado cru no HTML — proibido. Volta quando o campo passar pela curadoria.
      ...(loja ? { seller: { '@type': 'Organization', name: loja.nome } } : {}),
      /*
       * `discountCode` SAIU (ADR-0007): publicar o código no schema é entregá-lo pronto
       * ao Google e à resposta de IA, que é exatamente o vazamento que a revelação por
       * clique fecha. O nó Offer segue com preço, moeda e vendedor.
       */
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: `https://${tenant.canonical_host}/` },
        ...(loja
          ? [
              {
                '@type': 'ListItem',
                position: 2,
                name: `Cupons ${loja.nome}`,
                item: `https://${tenant.canonical_host}/cupom-${loja.slug}/`,
              },
            ]
          : []),
        { '@type': 'ListItem', position: loja ? 3 : 2, name: oferta.titulo, item: canonical },
      ],
    },
  ],
})
---

<Base
  titulo={tituloPagina}
  descricao={descricao}
  canonical={canonical}
  markdown={`/ofertas/${oferta.slug}.md`}
>
  <nav class="trilha" aria-label="Você está em">
    <a href="/">Início</a>
    {loja && <> › <a href={`/cupom-${loja.slug}/`}>Cupons {loja.nome}</a></>}
    <span> › {oferta.titulo}</span>
  </nav>

  <div class="oferta">
    <div class="topo">
      {
        heroSrc && (
          <img
            class="hero"
            src={heroSrc}
            srcset={heroSrcset}
            sizes="(min-width: 62rem) 40rem, 100vw"
            alt={img?.alt ?? oferta.titulo}
            width={img?.width ?? 1280}
            height={img?.height ?? 720}
            fetchpriority="high"
            decoding="async"
          />
        )
      }

      <h1>{oferta.titulo}</h1>
      {oferta.headline && <p class="headline">{oferta.headline}</p>}
    </div>

    {/*
      O card fica na coluna 2 no desktop e, no celular, cai logo depois do título — antes
      do editorial — porque é ele que carrega cupom e preço. É por isso que o topo e o
      conteúdo são dois blocos separados na grade em vez de um só.
    */}
    <aside class="lateral" aria-label="Resumo da oferta">
      <div class:list={['cartao-oferta', { 'com-cupom': Boolean(cupomVisivel) }]}>
        {
          logoLoja?.url && (
            <img
              class="logo"
              src={urlMidia(logoLoja.url)}
              alt={loja?.nome ?? ''}
              width={logoLoja.width ?? 160}
              height={logoLoja.height ?? 40}
              loading="lazy"
              decoding="async"
            />
          )
        }

        {/* a headline se repete de propósito: aqui ela é a promessa ao lado da ação, e
            quem rolou até o card não tem mais o topo da página na tela */}
        {oferta.headline && <p class="lateral-headline">{oferta.headline}</p>}

        <p class="tipo">{rotuloTipo[oferta.tipo ?? 'cupom'] ?? 'Oferta'}</p>

        {/*
          O diferencial da oferta, na cor de desconto. É RÓTULO editorial (o texto que o
          site escreve), e por isso não leva selo nem data — o número com carimbo é o
          `desconto_loja` logo abaixo, e os dois coexistem dizendo coisas diferentes.
        */}
        {oferta.rotulo_oferta && <p class="rotulo-oferta">{oferta.rotulo_oferta}</p>}

        {composto && (
          <p class="empilhado">
            <span class="empilhado-total">até {composto.total_pct}%</span>
            <span class="empilhado-partes">{decomposicao}</span>
          </p>
        )}

        {/* sem composição possível, o que se sabe aparece separado — nunca somado no chute */}
        {descontoLojaIsolado && (
          <p class="empilhado">
            <span class="empilhado-total">{descontoLojaIsolado.valor}%</span>
            <span class="empilhado-partes">da loja{cupomVisivel ? ' · cupom soma no checkout' : ''}</span>
          </p>
        )}

        {precoFormatado && (
          <p class="preco">
            {precoFormatado}
            {oferta.preco?.ciclo === 'mensal' && <span class="ciclo">/mês</span>}
            {precoEm && (
              <span class="preco-em">
                preço visto em {new Intl.DateTimeFormat('pt-BR', { dateStyle: 'short' }).format(precoEm)}
              </span>
            )}
          </p>
        )}

        {/* cupom sai no HTML inicial, com selo — nunca atrás de JS */}
        {cupomVisivel ? (
          <CupomCard cupom={cupomVisivel} compacto />
        ) : (
          <CtaAfiliado tipo="oferta" docId={oferta.id} rotulo="Ver oferta na loja" ref="oferta" />
        )}
      </div>

      <Compartilhar url={canonical} titulo={oferta.titulo} />
    </aside>

    <div class="conteudo">
      {
        beneficios.length > 0 && (
          <section class="beneficios">
            <h2>O que esta oferta inclui</h2>
            <ul>
              {beneficios.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </section>
        )
      }

      {corpoHtml && <div class="corpo" set:html={corpoHtml} />}
    </div>
  </div>

  {
    relacionadas.length > 0 && loja && (
      <section class="relacionadas">
        <h2>Outras ofertas {loja.nome}</h2>
        <div class="grade-relacionadas">
          {relacionadas.map((o) => (
            <CardOferta oferta={o} loja={loja.nome} />
          ))}
        </div>
      </section>
    )
  }

  {/* Barra fixa: mantém a ação na zona do polegar enquanto o editorial rola (v1.1). */}
  <div class="barra-fixa">
    <div class="barra-info">
      {precoFormatado && <strong class="barra-valor">{precoFormatado}</strong>}
      {cupomVisivel?.verificado_em && (
        <span class="barra-teste">
          testado em {new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }).format(new Date(cupomVisivel.verificado_em))}
        </span>
      )}
      {!cupomVisivel && oferta.tipo && <span class="barra-teste">{rotuloTipo[oferta.tipo] ?? 'Oferta'}</span>}
    </div>
    {cupomVisivel ? (
      <CtaAfiliado tipo="cupom" docId={cupomVisivel.id} rotulo="Pegar cupom" ref="barra" />
    ) : (
      <CtaAfiliado tipo="oferta" docId={oferta.id} rotulo="Ver oferta" ref="barra" />
    )}
  </div>

  <script is:inline type="application/ld+json" set:html={jsonLd} />
</Base>

<style>
  .trilha { font-size: 0.85rem; color: var(--rz-muted); margin-bottom: 0.5rem; }
  .trilha a { color: inherit; }

  /*
   * Duas colunas como a página do WordPress: editorial à esquerda, card da oferta à
   * direita, grudado enquanto o texto rola. São TRÊS áreas na grade (topo, lateral,
   * conteúdo) e não duas: assim, no celular, o card cai entre o título e o editorial —
   * onde a decisão acontece — sem precisar duplicar markup.
   */
  .oferta { display: block; }
  @media (min-width: 62rem) {
    .oferta {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 19rem;
      gap: 0 2rem;
      align-items: start;
    }
    .topo { grid-column: 1; grid-row: 1; }
    .conteudo { grid-column: 1; grid-row: 2; }
    .lateral {
      grid-column: 2;
      grid-row: 1 / span 2;
      position: sticky;
      /* o cabeçalho do site é sticky e tem ~65px; sem essa folga o card fica embaixo dele */
      top: 5.5rem;
    }
  }

  .hero {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 10px;
    background: var(--rz-surface-brand);
    margin-bottom: 1rem;
  }
  h1 { margin: 0 0 0.4rem; }
  .headline {
    margin: 0 0 1.25rem;
    font-size: 1.05rem;
    line-height: 1.45;
    color: var(--rz-muted);
  }

  /*
   * Centralizado, como no site antigo: o card é uma coluna estreita com logo, promessa,
   * número e ação — em coluna estreita, texto alinhado à esquerda deixa cada linha
   * começando num lugar e o olho volta ao início toda vez.
   */
  .cartao-oferta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.7rem;
    border: 1px solid var(--rz-borda);
    border-radius: 12px;
    padding: 1.25rem 1.1rem;
    margin: 0 0 0.5rem;
    background: var(--rz-surface);
  }
  /* tracejado SÓ quando há cupom: é a borda "de cupom", e usá-la numa oferta sem código
     prometeria um código que não existe */
  .cartao-oferta.com-cupom {
    border-style: dashed;
    border-width: 2px;
    border-color: var(--rz-borda-codigo);
  }
  /* o logo vem do WP em proporções variadas (svg de letreiro, png quadrado): teto de
     altura e `object-fit` impedem que um deles domine o card */
  .logo {
    max-width: 60%;
    max-height: 34px;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  /*
   * No desktop a headline do card fica ao LADO da que está sob o H1 e as duas se
   * sustentam. No celular elas empilham a dois dedos de distância e viram eco — some.
   */
  @media (max-width: 61.99rem) {
    .lateral-headline { display: none; }
  }
  .lateral-headline {
    margin: 0;
    font-family: var(--rz-fonte-titulos);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
  }
  .tipo { margin: 0; font-size: 0.9rem; font-weight: 600; color: var(--rz-brand); }
  .rotulo-oferta {
    margin: 0;
    font-family: var(--rz-fonte-titulos);
    font-size: 1.4rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--rz-deal);
  }
  .empilhado { margin: 0; display: flex; flex-direction: column; line-height: 1.15; }
  .empilhado-total {
    font-family: var(--rz-fonte-titulos);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--rz-deal);
  }
  .empilhado-partes { font-size: 0.78rem; color: var(--rz-muted); }
  .preco { margin: 0; font-size: 1.5rem; font-weight: 700; }
  .ciclo { font-size: 0.9rem; font-weight: 400; color: var(--rz-muted); }
  .preco-em { display: block; font-size: 0.75rem; font-weight: 400; color: var(--rz-muted); }
  /* o card é estreito: o cupom dentro dele ocupa a largura toda em vez de encolher */
  .cartao-oferta > :global(*) { max-width: 100%; }
  .cartao-oferta :global(.cupom.compacto) {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }
  .cartao-oferta :global(.cupom.compacto .corpo) {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }

  .beneficios h2 { margin-top: 0; font-size: 1.15rem; }
  .beneficios ul { margin: 0 0 1.5rem; padding: 0; list-style: none; }
  .beneficios li {
    position: relative;
    padding-left: 1.6rem;
    margin-bottom: 0.5rem;
    line-height: 1.45;
  }
  /* o "✓" é decoração via ::before: fora do texto, então leitor de tela não soa o
     símbolo item a item, e a lista continua sendo uma lista */
  .beneficios li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.42em;
    width: 0.95rem;
    height: 0.55rem;
    border-left: 2.5px solid var(--rz-verified);
    border-bottom: 2.5px solid var(--rz-verified);
    transform: rotate(-45deg);
  }

  .corpo :global(img) { max-width: 100%; height: auto; }
  .corpo :global(.tabela-rolavel) { overflow-x: auto; }
  .corpo :global(table) { border-collapse: collapse; min-width: 100%; }
  .corpo :global(th), .corpo :global(td) {
    border: 1px solid var(--rz-borda);
    padding: 0.5rem;
    text-align: left;
  }

  .relacionadas { margin-top: 2.5rem; }
  .grade-relacionadas {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
    gap: 1.1rem;
  }

  .barra-fixa {
    position: sticky;
    bottom: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 2rem -1.5rem 0;
    padding: 0.7rem 1.5rem;
    /* token, não branco fixo: a barra some num tenant de fundo escuro se for #fff */
    background: var(--rz-surface);
    border-top: 1px solid var(--rz-borda);
    box-shadow: 0 -2px 10px rgb(0 0 0 / 0.06);
  }
  .barra-info { display: flex; flex-direction: column; line-height: 1.2; }
  .barra-valor { font-family: var(--rz-fonte-titulos); font-size: 1.15rem; color: var(--rz-deal); }
  .barra-teste { font-size: 0.78rem; color: var(--rz-muted); }
  /* no desktop o card lateral já é a âncora da ação; a barra vira redundância grudada */
  @media (min-width: 62rem) {
    .barra-fixa { display: none; }
  }
  @media (max-width: 480px) {
    .barra-fixa { margin: 2rem -1rem 0; padding: 0.65rem 1rem; }
  }
</style>
