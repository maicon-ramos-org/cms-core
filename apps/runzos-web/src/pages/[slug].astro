---
/**
 * PRD 02/03 — post editorial em /{slug} (paridade de URL com o WordPress: os 735 posts
 * migrados mantêm exatamente o mesmo endereço, então nenhum link externo quebra).
 *
 * Decisão de render: SSR + cache por tag, não `prerender`. O corpo carrega dado que
 * muda sem o post ser editado (link de afiliado do catálogo, âncoras do auto-linker) e
 * o acervo tem 735 páginas — rebuild a cada edição não fecha. Invalidação vem do
 * webhook do Payload por tag (ADR-0001).
 *
 * Esta rota é o curinga de 1 segmento: rotas com prefixo estático (`/cupom-{loja}`)
 * têm prioridade no Astro, então não há conflito.
 */
import CardPost from '../components/CardPost.astro'
import { noFaq, noMigalhas, type No } from '@runzos/schema'
import Ferramentas from '../components/Ferramentas.astro'
import ChipsCategorias from '../components/ChipsCategorias.astro'
import Compartilhar from '../components/Compartilhar.astro'
import Base from '../layouts/Base.astro'
import {
  caminhoCanonico,
  getCategorias,
  getMapaAfiliados,
  getPageBySlug,
  getPostBySlug,
  getPostsRelacionados,
  urlMidia,
  type PostDTO,
} from '../lib/cms'
import { extraiSumario, lexicalParaHtml, lexicalParaTexto } from '../lib/lexical'

const tenant = Astro.locals.tenant
const slug = Astro.params.slug ?? ''

/**
 * Slugs que o WordPress servia com o corpo montado pelo builder (arquivo de produtos,
 * feed de posts, home). Cada um tem rota própria alimentada por DADO neste site, então
 * o corpo migrado deles é render velho e não pode ser servido — só o `home`, que não
 * tem URL própria (o WP servia na raiz), precisa ser barrado aqui: os outros já são
 * rotas estáticas e nem chegam neste curinga.
 */
const ARQUIVOS_DO_BUILDER = new Set(['home', 'apps', 'ofertas', 'blog'])

const post = await getPostBySlug(tenant.id, slug)

/*
 * Sem post, é página (institucional/conteúdo/contato) — e ela vai por REWRITE, não aqui.
 * O Astro empacota CSS por rota: com os dois templates nesta rota, toda página
 * institucional carregava o CSS do cartão de post, do compartilhar e do formulário de
 * contato. O `?__r=1` é o que faz `/pagina/{slug}` responder — direto, ela é 404.
 */
if (!post) {
  if (ARQUIVOS_DO_BUILDER.has(slug)) {
    return new Response('Página não encontrada.', { status: 404 })
  }
  const page = await getPageBySlug(tenant.id, slug)
  if (!page || page.template === 'apps') {
    return new Response('Página não encontrada.', { status: 404 })
  }
  /*
   * A query original vai JUNTO: o rewrite não a leva sozinho, e o alvo enxerga só o que
   * for passado aqui. Sem isto, o `?letra=` do índice do glossário sumia e a página
   * respondia sempre a primeira letra — 200 silencioso, filtro nenhum.
   */
  const params = new URLSearchParams(Astro.url.search)
  params.set('__r', '1')
  return Astro.rewrite(`/pagina/${caminhoCanonico(slug)}/?${params}`)
}

const [mapaAfiliados, categorias] = await Promise.all([getMapaAfiliados(tenant.id), getCategorias(tenant.id)])

const categoria = post?.categoria && typeof post.categoria === 'object' ? post.categoria : null
const autor = post?.autor && typeof post.autor === 'object' ? post.autor : null
const avatarAutor = autor?.avatar && typeof autor.avatar === 'object' ? autor.avatar : null
const capa = post?.capa && typeof post.capa === 'object' ? post.capa : null
/*
 * O original tem ~1200px e a coluna do artigo tem 944 no desktop: ali ele é o tamanho
 * certo. Quem ganha com o `srcset` é o celular, que renderiza em ~360 e baixava a mesma
 * imagem do desktop — o derivado de 640 (ver `regenera:tamanhos`) corta isso pela metade.
 *
 * COM o derivado `capa` (PRD 18 RF4: 1600×900, AVIF q55, recorte 16:9 pelo centro), ele
 * toma o lugar da original como candidato largo e como `src`, e o `<img>` declara
 * 1600×900. SEM ele — o acervo só ganha a `capa` quando o RF5 rodar — o hero sai
 * exatamente como antes: original + cartão, com as medidas da original.
 *
 * A ARMADILHA DA PROPORÇÃO: o `cartao` mantém a proporção da ORIGINAL (640×336 numa capa
 * de 1200×630, 640×427 numa de 1280×853) e a `capa` é 16:9 recortada. Com os dois no
 * mesmo `srcset`, o celular pode receber um candidato de proporção diferente da declarada
 * em `width`/`height`: a altura reservada não bate com o arquivo que chega (a página pula)
 * e o enquadramento muda entre celular e desktop. A classe `capa-169` fixa a CAIXA em
 * 16:9 com `object-fit: cover`: qualquer candidato é recortado pelo centro, que é o mesmo
 * recorte que a `capa` já tem — nenhum aparece distorcido e a altura reservada é sempre a
 * certa. Preferido a um `srcset` só com 16:9 porque esse tiraria o cartão, e o celular
 * voltaria a baixar 1600px para mostrar 360.
 */
const capa169 = capa?.sizes?.capa?.url ? capa.sizes.capa : null
const capaSrcset = [
  capa?.sizes?.cartao?.url ? `${urlMidia(capa.sizes.cartao.url)} 640w` : null,
  capa169?.url
    ? `${urlMidia(capa169.url)} ${capa169.width ?? 1600}w`
    : capa?.url
      ? `${urlMidia(capa.url)} ${capa.width ?? 1200}w`
      : null,
]
  .filter(Boolean)
  .join(', ')
const hero = capa169?.url
  ? { src: urlMidia(capa169.url), largura: capa169.width ?? 1600, altura: capa169.height ?? 900 }
  : { src: urlMidia(capa?.url), largura: capa?.width, altura: capa?.height }
const tags = Array.isArray(post?.tags)
  ? post.tags.filter((t): t is { id: string | number; nome: string; slug: string } => typeof t === 'object' && t !== null)
  : []

// `?.` porque o container de teste renderiza a rota sem o runtime de cache (mesmo padrão
// de `p/[slug].astro` e da home) — é essa renderização sem servidor que confere o HTML
if (Astro.cache?.enabled) {
  Astro.cache.set({
    maxAge: 3600,
    swr: 300,
    // daqui pra baixo só existe post: página saiu por rewrite antes deste ponto
    tags: [`tenant:${tenant.slug}`, `posts:${post.id}`, ...(categoria ? [`categorias:${categoria.id}`] : [])],
  })
}

const relacionados = post ? await getPostsRelacionados(tenant.id, post, 4) : ([] as PostDTO[])

const corpoHtml = lexicalParaHtml(post?.corpo, {
  reescreveAfiliado: (url) => mapaAfiliados.get(url) ?? mapaAfiliados.get(url.replace(/\/$/, '')) ?? null,
  resolveMidia: urlMidia,
  hostDoTenant: tenant.canonical_host,
})

/*
 * Índice do artigo. Sai dos títulos que o próprio conversor gerou, com os ids que ele
 * gerou — nada de JS no cliente montando lista de âncora.
 *
 * Só aparece com 3+ seções: em artigo curto, índice é uma segunda lista de títulos logo
 * antes dos títulos.
 */
const sumario = corpoHtml ? extraiSumario(corpoHtml) : []
const MIN_SUMARIO = 3

/*
 * Tempo de leitura. 200 palavras por minuto é a faixa medida pra leitura em português;
 * o número é do CORPO, não da página, então não conta menu nem rodapé.
 */
const palavras = post ? lexicalParaTexto(post.corpo).split(/\s+/).filter(Boolean).length : 0
const minutos = Math.max(1, Math.round(palavras / 200))


// title/description do Rank Math quando vieram na migração — são os que já ranqueiam
const titulo = post?.meta?.title || post?.titulo || ''
const descricao = post?.meta?.description || lexicalParaTexto(post?.corpo, 155)
const canonical = `https://${tenant.canonical_host}/${caminhoCanonico(post?.slug ?? slug)}/`

// datas do WP (createdAt/updatedAt do Payload são do import — publicá-las diria que o
// acervo inteiro nasceu no dia da migração)
const publicado = post?.publicado_em ? new Date(post.publicado_em) : null
const atualizado = post?.atualizado_em ? new Date(post.atualizado_em) : null
const dataLegivel = (d: Date) => new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long' }).format(d)

/*
 * Os nós DESTA página. O tronco (`Organization → WebSite → WebPage`) vem do Base, e por
 * isso não se repete aqui — era ele que faltava em 149 URLs até o Gate D medir schema.
 *
 * `Person` e `ImageObject` viram nó PRÓPRIO com `@id`, e o artigo passa a referenciá-los.
 * Antes o autor era objeto aninhado dentro do BlogPosting: funciona, mas o WordPress
 * declarava as duas entidades no grafo (Person em 64 URLs, ImageObject em 81), e entidade
 * com `@id` é o que permite ao consumidor ligá-la à mesma pessoa em outras páginas.
 */
const noAutor = autor
  ? {
      '@type': 'Person',
      '@id': `https://${tenant.canonical_host}/#/autor/${autor.slug ?? autor.id}`,
      name: autor.nome,
      ...(autor.sameAs?.length ? { sameAs: autor.sameAs } : {}),
    }
  : null

const nosDaPagina = [
  {
    /*
     * O tipo vem do que o WordPress declarava nesta URL, não de um padrão nosso: são 438
     * posts com NewsArticle, 82 com TechArticle e 27 com Article. Emitir BlogPosting em
     * todos trocaria o tipo de 63% do acervo no dia da virada — e `NewsArticle` é o que o
     * Google News pede. Array quando o WP declarava dois, que é JSON-LD válido e o que
     * ele fazia em 126 posts.
     */
    '@type':
      post?.tipo_schema && post.tipo_schema.length > 0
        ? post.tipo_schema.length === 1
          ? post.tipo_schema[0]
          : post.tipo_schema
        : 'BlogPosting',
    '@id': `${canonical}#post`,
    headline: post?.titulo ?? '',
    url: canonical,
    mainEntityOfPage: { '@id': `${canonical}#webpage` },
    ...(descricao ? { description: descricao } : {}),
    ...(publicado ? { datePublished: publicado.toISOString() } : {}),
    ...(atualizado ? { dateModified: atualizado.toISOString() } : {}),
    ...(capa?.url ? { image: { '@id': `${canonical}#primaryimage` } } : {}),
    ...(noAutor ? { author: { '@id': noAutor['@id'] } } : {}),
    publisher: { '@id': `https://${tenant.canonical_host}/#organization` },
    ...(categoria ? { articleSection: categoria.nome } : {}),
    ...(tags.length ? { keywords: tags.map((t) => t.nome).join(', ') } : {}),
  },
  noAutor,
  // o nó `#primaryimage` sai do `Base` (prop `imagem`): lá ele escolhe a `capa` 16:9 que o
  // Google Discover pede, com medidas e URL absoluta
  // 114 posts do acervo publicavam FAQPage e a réplica não — ver import:faq
  noFaq(canonical, post?.faq ?? []),
  noMigalhas(canonical, [
    { nome: 'Início', url: `https://${tenant.canonical_host}/` },
    ...(categoria ? [{ nome: categoria.nome, url: `https://${tenant.canonical_host}/categoria/${categoria.slug}/` }] : []),
    { nome: post?.titulo ?? '', url: canonical },
  ]),
  /*
   * `schema_extra`: nós que o WordPress declarava e que não cabem em nenhum construtor do
   * pacote, porque não são derivados do documento — são conteúdo editorial. O caso que
   * trouxe isto à tona é `Review`: 18 posts do acervo declaram nota (`ratingValue: 4`,
   * `bestRating: 5`) sobre um `SoftwareApplication` com preço, categoria e sameAs de
   * Wikidata/Crunchbase. Nada disso se deduz do post — ou vem do WP, ou some.
   *
   * O campo existia na coleção desde o contrato e NENHUM template lia. Campo gravado e
   * nunca emitido é pior que campo ausente: parece coberto no `colecoes.md` e some no HTML.
   *
   * `montaGrafo` deduplica por `@id`, então um nó daqui que colida com um construído acima
   * perde — a precedência é do que o código monta, e é a ordem certa: o construtor conhece
   * o documento de hoje, o `schema_extra` é foto do WordPress.
   */
  ...(Array.isArray(post?.schema_extra)
    ? // guarda em runtime, não `as`: é JSON livre vindo do banco, e nó sem `@type` não é
      // nó — emitir mesmo assim põe lixo no grafo, que é pior que não emitir
      post.schema_extra.filter(
        (n): n is No =>
          !!n && typeof n === 'object' && (typeof (n as No)['@type'] === 'string' || Array.isArray((n as No)['@type'])),
      )
    : []),
]
---

{post && (
<Base
  titulo={titulo}
  descricao={descricao}
  canonical={canonical}
  markdown={`/${post.slug}.md`}
  schema={nosDaPagina}
  imagem={capa}
  tipoOg="article"
>
  <nav class="trilha" aria-label="Você está em">
    <a href="/">Início</a>
    {categoria && <span> › {categoria.nome}</span>}
  </nav>

  <ChipsCategorias categorias={categorias} ativa={categoria?.slug ?? null} />

  <article>
    <h1>{post?.titulo}</h1>

    <p class="creditos">
      {autor && <span>Por {autor.nome}</span>}
      {publicado && (
        <>
          {autor && ' · '}
          <time datetime={publicado.toISOString()}>{dataLegivel(publicado)}</time>
        </>
      )}
      {atualizado && publicado && atualizado.getTime() - publicado.getTime() > 86_400_000 && (
        <span class="atualizado"> · atualizado em {dataLegivel(atualizado)}</span>
      )}
      {minutos > 0 && <span> · {minutos} min de leitura</span>}
    </p>

    {capa?.url && (
      <img
        class:list={['capa', { 'capa-169': Boolean(capa169) }]}
        src={hero.src}
        srcset={capaSrcset}
        sizes="(min-width: 48rem) 48rem, 100vw"
        alt={capa.alt ?? post?.titulo ?? ''}
        width={hero.largura}
        height={hero.altura}
        fetchpriority="high"
      />
    )}

    {
      sumario.length >= MIN_SUMARIO && (
        /* `<details open>`: recolhível sem JS, e aberto por padrão porque o índice serve
           pra decidir se vale ler — fechado, ele só ocupa espaço */
        <details class="sumario" open>
          <summary>Navegue por tópicos</summary>
          <ol>
            {sumario.map((i) => (
              <li class={i.nivel === 3 ? 'nivel-2' : 'nivel-1'}>
                <a href={`#${i.id}`}>{i.texto}</a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    {corpoHtml && <div class="corpo" set:html={corpoHtml} />}

    {/* eram `<span>`: a tag aparecia e não levava a lugar nenhum. Agora leva a /tag/{slug},
        que é `noindex, follow` — serve pra navegar e pro rastreador seguir, não pra rankear */}
    {tags.length > 0 && (
      <p class="tags">
        {tags.map((t) => (
          <a class="tag" href={`/tag/${t.slug}/`}>{t.nome}</a>
        ))}
      </p>
    )}

    <Compartilhar url={canonical} titulo={post?.titulo ?? ''} />

    {
      autor && (
        <aside class="autor">
          {/*
            A foto vem da MÍDIA, não do Gravatar. O site atual embute a URL do
            secure.gravatar.com, o que é uma requisição a domínio de terceiro em toda
            página de post — a mesma coisa que o projeto evita nas fontes. Aqui o arquivo
            está no acervo e sai do nosso domínio.
          */}
          {avatarAutor?.url && (
            <img
              class="autor-foto"
              src={urlMidia(avatarAutor.url)}
              alt={autor.nome}
              width={avatarAutor.width ?? 96}
              height={avatarAutor.height ?? 96}
              loading="lazy"
              decoding="async"
            />
          )}
          <div>
            <p class="autor-nome">{autor.nome}</p>
            {autor.bio && <p class="autor-bio">{autor.bio}</p>}
          </div>
        </aside>
      )
    }
  </article>

  {
    relacionados.length > 0 && (
      <section class="relacionados">
        <h2>Leia também</h2>
        <div class="grade">
          {relacionados.map((p) => (
            <CardPost post={p} />
          ))}
        </div>
      </section>
    )
  }

  <Ferramentas
    tipo="post"
    dados={{
      md: `/${post?.slug}.md`,
      post: {
        titulo: post?.titulo,
        autor: autor?.nome ?? null,
        publicado_em: publicado ? publicado.toISOString() : null,
        atualizado_em: atualizado ? atualizado.toISOString() : null,
        categoria: categoria?.nome ?? null,
        tags: tags.map((t) => t.nome),
        minutos_de_leitura: minutos,
        url: canonical,
      },
      sumario: sumario.map((i) => ({ titulo: i.texto, ancora: `#${i.id}` })),
    }}
  />

</Base>
)}

<style>
  .trilha { font-size: 0.85rem; color: var(--rz-muted); margin-bottom: 0.5rem; }
  .trilha a { color: inherit; }
  .creditos { font-size: 0.9rem; color: var(--rz-muted); margin-top: -0.5rem; }
  .atualizado { color: var(--rz-subtle); }
  /*
   * O artigo fica na MEDIDA de leitura, não na largura do container. Com o container em
   * 1190 o texto correria a linha inteira — cerca de 140 caracteres, quase o dobro do que
   * se lê sem perder a linha. O site atual usa 773px aqui; `--rz-medida` é isso.
   */
  article {
    max-width: var(--rz-medida);
    margin-inline: auto;
  }
  /*
   * A capa ESTOURA a medida de leitura: 768 é a largura certa pro texto e estreita demais
   * pra imagem de destaque. `calc(100% + 8rem)` com margem negativa a leva a ~896 sem sair
   * do container, e no celular a `min()` segura em 100%. É o que o site atual faz (texto
   * 773, capa 1000).
   */
  .capa {
    width: min(100%, calc(100% + 8rem));
    max-width: none;
    height: auto;
    margin: 1rem 0;
    border-radius: 10px;
  }
  @media (min-width: 60rem) {
    .capa { width: calc(100% + 8rem); margin-inline: -4rem; }
  }
  /* hero com o derivado `capa`: caixa sempre 16:9, qualquer que seja o candidato do
     `srcset` — ver `capa169` no frontmatter */
  .capa-169 {
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /*
   * Índice. `<details open>` para recolher sem JS. Números por CSS (`counter`) e não no
   * markup: a lista já é `<ol>`, e duplicar o número no texto faria o leitor de tela
   * anunciar "1. 1. Comparativo".
   */
  .sumario {
    margin: 1.5rem 0;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--rz-borda);
    border-radius: 10px;
    background: var(--rz-surface-brand);
  }
  .sumario summary {
    font-family: var(--rz-fonte-titulos);
    font-weight: 700;
    cursor: pointer;
    min-height: 32px;
    display: flex;
    align-items: center;
  }
  .sumario ol {
    counter-reset: item;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
  }
  .sumario li { counter-increment: item; line-height: 1.4; }
  .sumario li::before {
    content: counter(item) '.';
    display: inline-block;
    min-width: 1.4rem;
    color: var(--rz-muted);
    font-size: 0.85rem;
  }
  .sumario li.nivel-2 { padding-left: 1.4rem; }
  .sumario a {
    color: var(--rz-ink);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .sumario a:hover { color: var(--rz-brand); text-decoration: underline; }

  /* âncora do índice não pode parar embaixo do cabeçalho grudento */
  .corpo :global(h2),
  .corpo :global(h3),
  .corpo :global(h4) { scroll-margin-top: 5rem; }

  .autor {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
    margin-top: 2rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--rz-borda);
    border-radius: 10px;
    background: var(--rz-surface-brand);
  }
  .autor-nome {
    margin: 0;
    font-family: var(--rz-fonte-titulos);
    font-weight: 700;
  }
  .autor-bio { margin: 0.35rem 0 0; font-size: 0.9rem; color: var(--rz-muted); }
  .autor-foto {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 999px;
    object-fit: cover;
  }

  .relacionados .grade {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
    gap: 1.1rem;
      /*
     * TRÊS por linha no desktop, não quatro. Com o container fluido até 1520px, quatro
     * colunas davam cartão estreito numa tela larga — o oposto do que a largura extra
     * serve. Abaixo de 62rem o `auto-fill` acima assume e a grade se vira sozinha.
     */
    @media (min-width: 62rem) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}
  .corpo :global(img) { max-width: 100%; height: auto; }
  .corpo :global(.tabela-rolavel) { overflow-x: auto; margin: 1rem 0; }
  .corpo :global(table) { border-collapse: collapse; min-width: 100%; font-size: 0.95rem; }
  .corpo :global(th), .corpo :global(td) { border: 1px solid var(--rz-borda); padding: 0.5rem; text-align: left; }
  .corpo :global(th) { background: var(--rz-surface-brand); }
  .corpo :global(blockquote) { border-left: 3px solid var(--cor-primaria); margin: 1rem 0; padding-left: 1rem; color: var(--rz-muted); }
  .tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1.5rem; }
  /* era `#f1f1f1` fixo — cinza cravado em componente quebra em tenant de tema escuro */
  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0.15rem 0.7rem;
    border: 1px solid var(--rz-borda);
    border-radius: 999px;
    background: var(--rz-surface-brand);
    color: var(--rz-ink);
    font-size: 0.8rem;
    text-decoration: none;
  }
  .tag:hover { border-color: var(--rz-brand); color: var(--rz-brand); }
  .relacionados ul { padding-left: 1.2rem; }
</style>
